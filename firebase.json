{
  "firestore": {
    "rules": "firebase/firestore.rules",
    "indexes": "firebase/firestore.indexes.json"
  },
  "storage": {
    "rules": "firebase/storage.rules"
  },
  "functions": [
    {
      "source": "functions",
      "codebase": "foundation",
      "runtime": "nodejs22",
      "ignore": ["node_modules", ".git", "*-debug.log", ".env", ".env.*"],
      "predeploy": ["npm run build --workspace @social/functions"]
    }
  ],
  "emulators": {
    "firestore": {
      "host": "127.0.0.1",
      "port": 8080
    },
    "storage": {
      "host": "127.0.0.1",
      "port": 9199
    },
    "functions": {
      "host": "127.0.0.1",
      "port": 5001
    },
    "hub": {
      "host": "127.0.0.1",
      "port": 4400
    },
    "logging": {
      "host": "127.0.0.1",
      "port": 4500
    },
    "ui": {
      "enabled": false
    },
    "singleProjectMode": true,
    "auth": {
      "host": "127.0.0.1",
      "port": 9099
    }
  }
}
